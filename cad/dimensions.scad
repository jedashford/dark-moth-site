cradle_top=key_z+mount_offset+mount_radius;
remote_pcb_t=1.6;
switch_h=4.3;
switch_gap=0.1;
key_tip=carrier_bottom+carrier_t+remote_pcb_t+switch_h+switch_gap;
key_stop=-key_flange_t-key_travel;
logo_w=44;
logo_depth=0.5;
logo_y=48;
cx=ix/2;
cy=iy/2;
outer_w=ix+2*wall;
outer_d=iy+2*wall;
